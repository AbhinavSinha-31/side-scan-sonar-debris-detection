# Database Configuration
DATABASE_URL=sqlite:///./sonar_debris.db
# For PostgreSQL: postgresql://user:password@localhost:5432/sonar_debris

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=jpg,jpeg,png,tiff,tif,xtf,jsf
UPLOAD_DIRECTORY=./uploads

# Detection Configuration
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
DETECTION_MODEL_PATH=models/best.pt

# Shadow Analysis Configuration
SHADOW_THRESHOLD=0.4
SHADOW_MIN_AREA=50

# False Positive Filter Configuration
MODEL_CONFIDENCE_WEIGHT=0.5
SHADOW_SCORE_WEIGHT=0.3
SHAPE_SCORE_WEIGHT=0.2

# Geolocation Configuration
# Enable manual geolocation input (always clearly labeled as manual)
ENABLE_MANUAL_GEOLOCATION=true

# Report/Export Configuration (Phase 14)
# Where generated reports (CSV/JSON/PDF) are written
REPORT_EXPORT_DIRECTORY=./data/exports/reports
# Optional report record expiry (days). Leave empty for no expiry.
REPORT_EXPIRY_DAYS=

# AI Assistant Configuration (Phase 17)
# The AI Assistant is a LOCAL, deterministic rule-based assistant. It answers
# natural-language questions using real SQLite detection data and does NOT
# require any external LLM, API key, or network access.
#
# Optionally enable a real conversational LLM backend. All answers remain
# grounded in the real stored scan/detection data — the model is only used to
# phrase the answer, never to invent numbers.
#   LLM_PROVIDER=disabled | ollama | openai
LLM_PROVIDER=disabled
# Max input length (chars) accepted for a single assistant message.
LLM_MAX_INPUT_LENGTH=1000
# Provider request timeout in seconds.
LLM_TIMEOUT_SECONDS=30.0

# Ollama Configuration (if using local Ollama)
# Start Ollama, then pull a model, e.g.:  ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI Configuration (optional; backend-only credential, NEVER exposed to the
# frontend). When using the OpenAI provider, also set LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Training Configuration
TRAINING_BATCH_SIZE=16
TRAINING_EPOCHS=100
TRAINING_LR=0.001
TRAINING_DEVICE=cuda
# Set to 'cpu' if CUDA is not available

# YOLOv8 Configuration
YOLOV8_IMAGE_SIZE=640
YOLOV8_WORKERS=4

# Data Augmentation
DATA_AUGMENTATION_ENABLED=true

# Demo Mode
DEMO_MODE=false
DEMO_DATA_PATH=./data/demo

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Security
SECRET_KEY=your_secret_key_here
SECURE_COOKIES=true
